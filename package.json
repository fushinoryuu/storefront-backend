{
  "name": "storefront-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Storefront backend: three AWS microservices built with CDK in TypeScript",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "pretypecheck": "npm run generate:schemas",
    "typecheck": "tsc",
    "pretest": "npm run generate:schemas",
    "test": "vitest run",
    "lint:specs": "tsx scripts/lint-specs.ts",
    "bundle:specs": "tsx scripts/bundle-specs.ts",
    "synth": "npm run synth:dev && npm run synth:prod",
    "synth:dev": "cdk synth -c stage=dev --output cdk.out/dev --quiet",
    "synth:prod": "cdk synth -c stage=prod --output cdk.out/prod --quiet",
    "get-api-keys": "tsx scripts/get-api-keys.ts",
    "aws:login": "aws sso login --profile storefront && aws sts get-caller-identity --profile storefront",
    "deploy:secrets": "cdk deploy --profile storefront Secrets",
    "destroy:secrets": "cdk destroy --profile storefront Secrets",
    "deploy:api-gateway-account": "cdk deploy --profile storefront ApiGatewayAccount",
    "destroy:api-gateway-account": "cdk destroy --profile storefront ApiGatewayAccount",
    "deploy:platform": "cdk deploy --profile storefront Platform",
    "destroy:platform": "cdk destroy --profile storefront Platform"
  },
  "devDependencies": {
    "@aws-sdk/client-api-gateway": "^3.1171.0",
    "@aws-sdk/client-ssm": "^3.1171.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/openapi-core": "^2.79.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "ajv": "^8.20.0",
    "aws-cdk": "^2.1148.1",
    "cdk-nag": "^3.0.2",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.36.0",
    "@aws-sdk/client-dynamodb": "^3.1171.0",
    "@aws-sdk/client-secrets-manager": "^3.1171.0",
    "@aws-sdk/lib-dynamodb": "^3.1171.0",
    "@launchdarkly/node-server-sdk": "^9.16.6",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
