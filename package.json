{
  "name": "storefront-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Storefront backend: three AWS microservices built with CDK in TypeScript",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "test": "vitest run",
    "synth": "npm run synth:dev && npm run synth:prod",
    "synth:dev": "cdk synth -c stage=dev --output cdk.out/dev --quiet",
    "synth:prod": "cdk synth -c stage=prod --output cdk.out/prod --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "aws-cdk": "2.1146.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1"
  }
}
