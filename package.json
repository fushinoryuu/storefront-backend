{
  "name": "storefront-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Storefront backend: three AWS microservices built with CDK in TypeScript",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "pretypecheck": "npm run generate:schemas",
    "typecheck": "tsc",
    "pretest": "npm run generate:schemas",
    "test": "vitest run",
    "lint:specs": "tsx scripts/lint-specs.ts",
    "bundle:specs": "tsx scripts/bundle-specs.ts",
    "synth": "npm run synth:dev && npm run synth:prod",
    "synth:dev": "cdk synth -c stage=dev --output cdk.out/dev --quiet",
    "synth:prod": "cdk synth -c stage=prod --output cdk.out/prod --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/openapi-core": "^2.72.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "aws-cdk": "2.1146.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "2.36.0",
    "@aws-sdk/client-dynamodb": "^3.1166.0",
    "@aws-sdk/client-secrets-manager": "^3.1166.0",
    "@aws-sdk/lib-dynamodb": "^3.1166.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "zod": "^4.6.7"
  }
}
